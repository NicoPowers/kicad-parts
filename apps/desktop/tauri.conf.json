{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KiCad Parts",
  "version": "0.1.0",
  "identifier": "org.kicadparts.desktop",
  "build": {
    "frontendDist": "../desktop-ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../desktop-ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../desktop-ui",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KiCad Parts",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
